{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./app/*"],
      "@civicsignal/ui/*": ["../../packages/ui/src/*"],
      "@civicsignal/db/*": ["../../packages/db/src/*"],
      "@civicsignal/crypto/*": ["../../packages/crypto/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
